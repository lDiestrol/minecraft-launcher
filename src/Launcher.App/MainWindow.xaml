<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.App.ViewModels"
        mc:Ignorable="d"
        Title="Minecraft Launcher"
        Width="600"
        Height="650"
        MinWidth="520"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#14171C"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1D2229" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343B45" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA5B1" />
        <SolidColorBrush x:Key="AccentBrush" Color="#64D27A" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#78E58D" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#12151A" />
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="CaretBrush" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#12151A" />
            <Setter Property="Foreground" Value="#161A1F" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="Background" Value="#2A3039" />
            <Setter Property="BorderBrush" Value="#414A56" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#353D48" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#101410" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="22,13" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid>
    <Grid Margin="34">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Onboarding}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Minecraft Launcher" />
            <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="{Binding Version}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,34,0,24"
                Padding="28"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock FontSize="27" FontWeight="SemiBold" Text="{Binding OnboardingTitle}" />
                <TextBlock Margin="0,9,0,25"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding OnboardingDescription}"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource SectionLabel}" Text="АДРЕС СЕРВЕРА" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="https://example.org или прямая ссылка на bootstrap.json" />
                <TextBlock Margin="0,14,0,0"
                           Foreground="#FF7B7B"
                           Text="{Binding ErrorText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ProgressBar Height="3"
                             Margin="0,20,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Margin="0,22,0,0"
                        Command="{Binding ConnectCommand}"
                        Content="ПОДКЛЮЧИТЬСЯ"
                        Style="{StaticResource PrimaryButton}" />
                <Button Margin="0,10,0,0"
                        Command="{Binding CancelSettingsCommand}"
                        Content="Отмена"
                        Visibility="{Binding IsChangingServer, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Text="HTTPS обязателен; HTTP разрешён только для localhost." />
    </Grid>

    <Grid Margin="34">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Main}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Minecraft Launcher" />
            <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="{Binding Version}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,26,0,20"
                Padding="26"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="СЕРВЕР" />
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding ServerName}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,21,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="НИК" />
                    <TextBox MaxLength="16" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="СБОРКА" />
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="RAM" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding RamDisplay}" />
                    <Slider Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Minimum="2048"
                            Maximum="{Binding MaximumRamMb}"
                            Value="{Binding RamMb}"
                            TickFrequency="1024"
                            IsSnapToTickEnabled="True" />
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="СТАТУС" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF7B7B"
                               Text="{Binding ErrorText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Height="3"
                                 Margin="0,12,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Button Grid.Row="5"
                        Margin="0,23,0,0"
                        Command="{Binding PlayCommand}"
                        Content="ИГРАТЬ"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left"
                    Command="{Binding OpenSettingsCommand}"
                    Content="Настройки" />
            <Button Grid.Column="1"
                    IsEnabled="False"
                    Content="Проверить файлы"
                    ToolTip="Проверка игровых файлов будет реализована на следующем этапе." />
        </Grid>
    </Grid>
    </Grid>
</Window>

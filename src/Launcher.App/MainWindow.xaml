<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.App.ViewModels"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Minecraft Launcher"
        Icon="Assets/Launcher.ico"
        Width="1120"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="WindowFrame"
                Grid.RowSpan="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="{StaticResource NavigationBrush}"
                MouseRightButtonUp="TitleBar_MouseRightButtonUp"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="Assets/Launcher.png" />
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="MINECRAFT LAUNCHER" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Width="46"
                            Height="41"
                            Padding="0"
                            automation:AutomationProperties.Name="Свернуть окно"
                            Click="MinimizeButton_Click"
                            Content="—"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButton}" />
                    <Button x:Name="MaximizeRestoreButton"
                            Width="46"
                            Height="41"
                            Padding="0"
                            automation:AutomationProperties.Name="Развернуть окно"
                            Click="MaximizeRestoreButton_Click"
                            Content="□"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarButton}" />
                    <Button x:Name="CloseButton"
                            Width="46"
                            Height="41"
                            Padding="0"
                            automation:AutomationProperties.Name="Закрыть окно"
                            Click="CloseButton_Click"
                            Content="×"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource TitleBarCloseButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- First-run and reconnect flow intentionally remains a focused, standalone screen. -->
        <Grid Grid.Row="1" Margin="44">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Onboarding}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" Background="{StaticResource AccentDarkBrush}" CornerRadius="10">
                        <Image Width="28" Height="28" Source="Assets/Launcher.png" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="MINECRAFT LAUNCHER" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="DARK GAMING CLIENT" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" Content="Настройки" Style="{StaticResource QuietButton}" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,34,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Text="ЕДИНАЯ ТОЧКА ВХОДА" />
                    <TextBlock Margin="0,15,0,0" FontSize="42" FontWeight="SemiBold" LineHeight="48" Text="Ваш сервер.&#10;Ваша сборка." TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" FontSize="16" LineHeight="24" Text="Launcher получит игровые профили, проверит файлы сборки и подготовит Minecraft автоматически." TextWrapping="Wrap" />
                    <StackPanel Margin="0,30,0,0">
                        <TextBlock Margin="0,0,0,11" Foreground="{StaticResource MutedBrush}" Text="✓  Проверка SHA-256 и восстановление файлов" />
                        <TextBlock Margin="0,0,0,11" Foreground="{StaticResource MutedBrush}" Text="✓  Managed Java и точная версия Fabric" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="✓  Несколько профилей через один адрес" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" MaxWidth="460" VerticalAlignment="Center" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Width="64" Height="64" HorizontalAlignment="Left" Background="{StaticResource AccentDarkBrush}" CornerRadius="14">
                            <Image Width="42" Height="42" Source="Assets/Launcher.png" />
                        </Border>
                        <TextBlock Margin="0,22,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding OnboardingTitle}" />
                        <TextBlock Margin="0,8,0,25" Style="{StaticResource MutedText}" Text="{Binding OnboardingDescription}" />
                        <TextBlock Style="{StaticResource SectionLabel}" Text="АДРЕС LAUNCHER SERVER" />
                        <TextBox automation:AutomationProperties.Name="Адрес сервера" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например, https://example.org" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="Например: https://example.org" />
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding ServerUrlValidationText}" TextWrapping="Wrap" Visibility="{Binding HasServerUrlValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Margin="0,14,0,0" Padding="12" Background="#281820" BorderBrush="#5A2C39" BorderThickness="1" CornerRadius="7" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                        </Border>
                        <ProgressBar Margin="0,18,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,22,0,0" Command="{Binding ConnectCommand}" Content="{Binding ConnectButtonText}" IsDefault="True" Style="{StaticResource PrimaryButton}" />
                        <Button Margin="0,9,0,0" Command="{Binding ChangeServerCommand}" Content="Изменить сервер" Style="{StaticResource QuietButton}" Visibility="{Binding HasConnectionFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Grid.Row="2" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="{Binding Version}" />
        </Grid>
        <!-- Main application shell, shared by the game dashboard and settings. -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Main}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Settings}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,24,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="{StaticResource AccentDarkBrush}" CornerRadius="10">
                            <Image Width="27" Height="27" Source="Assets/Launcher.png" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="LAUNCHER" />
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" Text="DARK GAMING" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,38,0,0">
                        <TextBlock Margin="14,0,0,8" Style="{StaticResource SectionLabel}" Text="НАВИГАЦИЯ" />
                        <Button Command="{Binding CancelSettingsCommand}" Content="Главная">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Main}">
                                            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="#246D68" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding OpenSettingsCommand}" Content="Настройки">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Settings}">
                                            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="#246D68" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Padding="14" Background="#111A22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="OFFLINE PROFILE" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding Version}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <!-- Main dashboard -->
                <Grid Margin="30,26,30,28">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Main}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Игровой центр" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding ServerName}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,8" VerticalAlignment="Center" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="Профиль загружен" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,22,0,0" Padding="18" Background="{StaticResource AccentDarkBrush}" BorderBrush="#246D68" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsUpdateOfferVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding UpdateOfferText}" />
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                                <ProgressBar Margin="0,11,0,0" Maximum="100" Value="{Binding UpdateProgressValue, Mode=OneWay}" Visibility="{Binding IsUpdateProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Button Command="{Binding DownloadUpdateCommand}" Content="Обновить" Visibility="{Binding IsUpdateOfferDownloadVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Command="{Binding ApplyUpdateCommand}" Content="Перезапустить" Visibility="{Binding IsUpdateOfferApplyVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="8,0,0,0" Command="{Binding DismissUpdateOfferCommand}" Content="Позже" Style="{StaticResource QuietButton}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,18,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="DashboardLayout" Margin="0,0,7,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="360" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" MinWidth="270" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ProfileHero"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Background="{StaticResource HeroBrush}"
                                    BorderBrush="#315C60"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="14">
                                <Grid MinHeight="408">
                                    <Canvas IsHitTestVisible="False" Opacity="0.9">
                                        <Ellipse Width="390"
                                                 Height="390"
                                                 Canvas.Top="-170"
                                                 Canvas.Right="-95">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Offset="0" Color="#4527D3C2" />
                                                    <GradientStop Offset="0.55" Color="#161C6C69" />
                                                    <GradientStop Offset="1" Color="#00131A23" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Border Width="360"
                                                Height="92"
                                                Canvas.Top="230"
                                                Canvas.Right="-88"
                                                Background="#151E5A59"
                                                BorderBrush="#33357975"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-18" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Width="300"
                                                Height="72"
                                                Canvas.Top="315"
                                                Canvas.Right="-40"
                                                Background="#101D4548"
                                                BorderBrush="#282E5558"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-18" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <TextBlock Canvas.Top="92"
                                                   Canvas.Right="-12"
                                                   Foreground="#0DFFFFFF"
                                                   FontSize="176"
                                                   FontWeight="Black"
                                                   Text="WT" />
                                    </Canvas>

                                    <Grid Margin="30,27,30,28">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,6"
                                                    Background="#B30D3432"
                                                    BorderBrush="#4D27D3C2"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Text="ВЫБРАННЫЙ ПРОФИЛЬ" />
                                            </Border>
                                            <TextBlock Margin="0,16,150,0"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="36"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedProfile.Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,20,120,0">
                                                <Border Style="{StaticResource HeroPill}">
                                                    <TextBlock><Run Foreground="{StaticResource MutedBrush}" Text="Minecraft  " /><Run FontWeight="SemiBold" Text="{Binding SelectedProfile.MinecraftVersion}" /></TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource HeroPill}">
                                                    <TextBlock><Run Foreground="{StaticResource MutedBrush}" Text="Fabric  " /><Run FontWeight="SemiBold" Text="{Binding SelectedProfile.LoaderVersion}" /></TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource HeroPill}">
                                                    <TextBlock><Run Foreground="{StaticResource MutedBrush}" Text="Pack  " /><Run FontWeight="SemiBold" Text="{Binding SelectedProfile.PackVersion}" /></TextBlock>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Margin="0,22,0,20" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="СЕРВЕР" />
                                                <TextBlock FontSize="14">
                                                    <Run Text="{Binding SelectedProfile.ServerAddress}" /><Run Text=":" /><Run Text="{Binding SelectedProfile.ServerPort}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="OFFLINE NICKNAME" />
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Grid.Row="2"
                                                MinHeight="66"
                                                automation:AutomationProperties.Name="Играть"
                                                Command="{Binding PlayCommand}"
                                                Content="{Binding PlayButtonText}"
                                                FontSize="20"
                                                Style="{StaticResource PrimaryButton}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="DashboardSidebar" Grid.Row="0" Grid.Column="2">
                                <Border Style="{StaticResource CompactCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Состояние сборки" />
                                            <Border Grid.Column="1"
                                                    Width="10"
                                                    Height="10"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="5"
                                                    ToolTip="{Binding StatusText}" />
                                        </Grid>
                                        <Border Margin="0,15,0,0" Padding="12" CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#111F252B" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Background" Value="#2B261F12" />
                                                            <Setter Property="BorderBrush" Value="#6B5A3A1D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                            <Setter Property="Background" Value="#17153834" />
                                                            <Setter Property="BorderBrush" Value="#5627D3C2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Background" Value="#2A20151A" />
                                                            <Setter Property="BorderBrush" Value="#704D2831" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="ТЕКУЩЕЕ СОСТОЯНИЕ" />
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding StatusText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,10,0,0"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   Text="{Binding ErrorText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ProgressBar Margin="0,14,0,0"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                     Maximum="100"
                                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Text="{Binding ProgressDetails}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasProgressDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,12,0,0"
                                                Command="{Binding CancelGameCommand}"
                                                Content="Отменить подготовку"
                                                Visibility="{Binding IsGamePreparing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,9,0,0"
                                                Command="{Binding RepairCommand}"
                                                Content="Проверить файлы"
                                                Style="{StaticResource QuietButton}"
                                                ToolTip="Проверить файлы сборки и восстановить повреждённые." />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource CompactCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Управление файлами" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Text="Папки выбранного игрового профиля"
                                                   TextWrapping="Wrap" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="9,9"
                                                    automation:AutomationProperties.Name="Открыть папку игры"
                                                    Command="{Binding OpenGameFolderCommand}"
                                                    Content="Папка игры"
                                                    ToolTip="Открыть корневую папку выбранного профиля" />
                                            <Button Grid.Row="0"
                                                    Grid.Column="2"
                                                    Padding="9,9"
                                                    automation:AutomationProperties.Name="Открыть папку модов"
                                                    Command="{Binding OpenModsFolderCommand}"
                                                    Content="Моды"
                                                    ToolTip="Открыть папку mods выбранного профиля" />
                                            <Button Grid.Row="2"
                                                    Grid.Column="0"
                                                    Padding="9,9"
                                                    automation:AutomationProperties.Name="Открыть папку ресурспаков"
                                                    Command="{Binding OpenResourcePacksFolderCommand}"
                                                    Content="Ресурспаки"
                                                    ToolTip="Открыть папку resourcepacks выбранного профиля" />
                                            <Button Grid.Row="2"
                                                    Grid.Column="2"
                                                    Padding="9,9"
                                                    automation:AutomationProperties.Name="Открыть папку шейдеров"
                                                    Command="{Binding OpenShaderPacksFolderCommand}"
                                                    Content="Шейдеры"
                                                    ToolTip="Открыть папку shaderpacks выбранного профиля" />
                                        </Grid>
                                        <Border Margin="0,15,0,13"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0" />
                                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Text="Удаляются только файлы, отмеченные Launcher как управляемые. Пользовательские данные сохраняются."
                                                   TextWrapping="Wrap" />
                                        <Button Margin="0,10,0,0"
                                                automation:AutomationProperties.Name="Удалить файлы сборки"
                                                Command="{Binding DeleteManagedPackCommand}"
                                                Content="Удалить файлы сборки"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="Удалить управляемые файлы для повторной загрузки" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource CompactCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Быстрый запуск" />
                                        <TextBlock Margin="0,14,0,0" Style="{StaticResource SectionLabel}" Text="ИГРОВОЙ ПРОФИЛЬ" />
                                        <ComboBox automation:AutomationProperties.Name="Игровой профиль"
                                                  ItemsSource="{Binding Profiles}"
                                                  SelectedItem="{Binding SelectedProfile}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="ВЫДЕЛЕНО RAM" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding RamDisplay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                <!-- Settings -->
                <Grid Margin="30,26,30,28">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Screen}" Value="{x:Static vm:LauncherScreen.Settings}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Настройки" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Text="Сервер, игровой профиль и обслуживание Launcher" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CancelSettingsCommand}" Content="Готово" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="SettingsLayout" Margin="0,0,7,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="300" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="SettingsPrimary" Grid.Row="0" Grid.Column="0">
                                <Border Style="{StaticResource CompactCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Launcher server" />
                                        <TextBlock Margin="0,5,0,13"
                                                   Style="{StaticResource SecondaryText}"
                                                   Text="Адрес сайта сервера или прямая ссылка на bootstrap-конфигурацию." />
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="ПОЛНЫЙ АДРЕС" />
                                        <TextBox MinHeight="62"
                                                 AcceptsReturn="False"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 automation:AutomationProperties.HelpText="Полный адрес Launcher Server"
                                                 automation:AutomationProperties.Name="Адрес сервера"
                                                 Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ServerUrl}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Text="Адрес можно полностью просмотреть, выделить и отредактировать в поле выше."
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   Text="{Binding ServerUrlValidationText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasServerUrlValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   Text="{Binding ErrorText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,13,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding ConnectCommand}"
                                                Content="Подключиться" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource CompactCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Параметры игры" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="OFFLINE NICKNAME" />
                                                <TextBox MaxLength="16"
                                                         automation:AutomationProperties.Name="Ник игрока"
                                                         Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="ИГРОВОЙ ПРОФИЛЬ" />
                                                <ComboBox automation:AutomationProperties.Name="Игровой профиль"
                                                          ItemsSource="{Binding Profiles}"
                                                          SelectedItem="{Binding SelectedProfile}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="ОПЕРАТИВНАЯ ПАМЯТЬ" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding RamDisplay}" />
                                            <Slider Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,2,0,0"
                                                    automation:AutomationProperties.Name="Оперативная память"
                                                    Minimum="2048"
                                                    Maximum="{Binding MaximumRamMb}"
                                                    Value="{Binding RamMb}"
                                                    TickFrequency="1024"
                                                    IsSnapToTickEnabled="True" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SettingsSecondary" Grid.Row="0" Grid.Column="2">
                                <Border Style="{StaticResource CompactCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Обновления Launcher" />
                                            <Border Grid.Column="1"
                                                    Padding="9,5"
                                                    Background="#172831"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Version}" />
                                            </Border>
                                        </Grid>
                                        <Border Margin="0,13,0,0"
                                                Padding="12"
                                                Background="#111B252D"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Velopack" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding UpdateStatusText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <ProgressBar Margin="0,12,0,0"
                                                     Maximum="100"
                                                     Value="{Binding UpdateProgressValue, Mode=OneWay}"
                                                     Visibility="{Binding IsUpdateProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <WrapPanel Margin="0,13,0,0">
                                            <Button Command="{Binding CheckForUpdatesCommand}" Content="Проверить обновления" />
                                            <Button Margin="8,0,0,0"
                                                    Command="{Binding DownloadUpdateCommand}"
                                                    Content="Скачать"
                                                    Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Margin="8,0,0,0"
                                                    Command="{Binding ApplyUpdateCommand}"
                                                    Content="Перезапустить"
                                                    Visibility="{Binding IsUpdateDownloaded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource CompactCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46"
                                                Height="46"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AccentDarkBrush}"
                                                CornerRadius="10">
                                            <Image Width="30" Height="30" Source="Assets/Launcher.png" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Minecraft Launcher" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="Локальный клиент для управляемых сборок."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="12"
                                                       Text="github.com/lDiestrol/minecraft-launcher" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

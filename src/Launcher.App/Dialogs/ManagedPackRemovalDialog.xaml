<Window x:Class="Launcher.App.Dialogs.ManagedPackRemovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удалить файлы сборки"
        Width="540"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        AllowsTransparency="True">
    <Border Margin="12"
            Padding="26"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#80563A42"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.45" ShadowDepth="7" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Foreground="{StaticResource DangerTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Text="УДАЛЕНИЕ СБОРКИ" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="Удалить файлы выбранной сборки?"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ProfileNameText"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="#281B2026"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource DangerTextBrush}"
                               FontWeight="SemiBold"
                               Text="Будет удалено" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Только файлы, которые Launcher пометил как управляемые текущей сборкой, и локальное состояние установки. При следующем запуске или проверке они будут скачаны заново."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,16,0,0"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold"
                       Text="Будет сохранено" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Сохранения, скриншоты, ресурспаки, шейдеры, options и другие неуправляемые настройки, неуправляемые моды, другие профили, общие assets, libraries и Java runtime."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Text="Если состояние установки повреждено или путь небезопасен, удаление будет остановлено."
                       TextWrapping="Wrap" />

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Content="Отмена" />
                <Button Grid.Column="2"
                        IsDefault="True"
                        Click="Delete_Click"
                        Content="Удалить"
                        Style="{StaticResource DangerButton}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
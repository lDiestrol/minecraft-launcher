    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Launcher.InstallHelper</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>helper.manifest</ApplicationManifest>
    <DefineConstants Condition="'$(InstallerDiagnostic)' == 'true'">$(DefineConstants);INSTALLER_DIAGNOSTIC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Launcher.Infrastructure\Launcher.Infrastructure.csproj" />
  </ItemGroup>
</Project>
